# Server-only configuration. The shell and build work with these values empty;
# GET /api/phrases and npm run seed require both Supabase values.
# Never prefix these variables with NEXT_PUBLIC_ or expose them in next.config.ts.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Phase 5: Argon2id hash, never the plaintext admin password.
ADMIN_PASSWORD_HASH=
# An independent, cryptographically random session-signing secret.
ADMIN_SESSION_SECRET=
