# Server-only configuration for the persistence and authentication phases.
# Phase 1 starts and builds with these values empty.
# Never prefix these variables with NEXT_PUBLIC_ or expose them in next.config.ts.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Argon2id hash, never the plaintext admin password.
ADMIN_PASSWORD_HASH=
# An independent, cryptographically random session-signing secret.
ADMIN_SESSION_SECRET=
